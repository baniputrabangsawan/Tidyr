{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidyr",
  "version": "0.1.0",
  "identifier": "id.tidyr.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Tidyr",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Bani Putra Bangsawan",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Rapikan folder dan atasi file kembar, aman dan lokal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/baniputrabangsawan/Tidyr/releases/latest/download/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBQTRFNDcyQzBFQzEzNkMKUldSc0UrekFjdVNrS3N1RVBkeWNDaGJBYWdySTdvbS9mRldoZFJ2Ukk3UTI3MENCU3RGam0weWQK"
    }
  }
}
